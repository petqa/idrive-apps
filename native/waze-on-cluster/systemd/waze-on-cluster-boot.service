[Unit]
Description=waze-on-cluster boot check: restore the original carplay before it starts if the map patch keeps the head unit from starting
RequiresMountsFor=/var/opt
After=local-fs.target
# carplay.service (WantedBy=late.target, after multi-user.target) starts only
# once this has finished, failed or timed out; it does not require it.
Before=carplay.service

[Service]
# Root, like patchd. It decides from small files (PATCH.md "Boot recovery"):
# with nothing to do it exits in about the time Node takes to start; before
# a patched carplay starts it records this boot. At the threshold, or when
# it cannot save that record, it remounts / read-write only to write the
# verified original back, then read-only again, in a second or two.
Type=oneshot
RemainAfterExit=yes
ExecStart=-/usr/bin/node /var/opt/waze-on-cluster/current/recovery.js boot carplay
# The step exits by 56 s whatever hangs (recovery.js BOOT_EXIT_MS: up to
# 10 s for the other boot step's restore, RESTORE_BOUND_MS, then one try to
# put / back read-only), inside the start timeout. A stop mid-restore lets it finish, inside the stop timeout,
# so / is not left writable; KillMode=mixed signals only the step, not its
# mount children.
TimeoutStartSec=75
TimeoutStopSec=75
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
